# Copy to .env (or export in your shell) to run against real providers.
# Nothing in TapeDeck requires these: tests, the CLI and the example all run
# offline with the mock providers when they are unset. Replaying a tape
# never calls the API, even when keys are set.

# Used by the `openai` SDK (and by examples/research-agent when set).
OPENAI_API_KEY=
# Optional: model for examples/research-agent (default gpt-4.1-mini).
OPENAI_MODEL=

# Used by the `@anthropic-ai/sdk` SDK.
ANTHROPIC_API_KEY=
