{
  "name": "tapedeck",
  "version": "0.1.0",
  "description": "VCR for AI agents: deterministic record/replay and regression testing for LLM agent applications.",
  "license": "MIT",
  "author": "Niloy Bhuiyan",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./vitest": {
      "types": "./dist/testing/vitest.d.ts",
      "import": "./dist/testing/vitest.js"
    },
    "./jest": {
      "types": "./dist/testing/jest.d.ts",
      "import": "./dist/testing/jest.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tapedeck": "./dist/cli/bin.js"
  },
  "keywords": [
    "llm",
    "agents",
    "testing",
    "record",
    "replay",
    "vcr",
    "openai",
    "anthropic",
    "regression"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Niloy-Bhuiyan/tapedeck.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tapedeck": "tsx src/cli/bin.ts",
    "example": "node --import tsx examples/research-agent/main.ts",
    "example:record": "tsx src/cli/bin.ts record -n research-agent -o examples/research-agent/tapes/research-agent.tape.json -- node --import tsx examples/research-agent/main.ts",
    "example:replay": "tsx src/cli/bin.ts replay examples/research-agent/tapes/research-agent.tape.json --against \"node --import tsx examples/research-agent/main.ts\"",
    "example:regression": "tsx src/cli/bin.ts replay examples/research-agent/tapes/research-agent.tape.json --against \"node --import tsx examples/research-agent/main.ts --variant=v2\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@types/node": "^22.20.4",
    "openai": "^7.23.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "openai": ">=4",
    "@anthropic-ai/sdk": ">=0.20",
    "vitest": ">=1"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
